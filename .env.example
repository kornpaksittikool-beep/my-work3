# Copy to .env and edit. .env is gitignored.
# Anything already set in the shell wins over these values, and any flag passed
# after `--` on the command line wins over both.

# ---------------------------------------------------------------------------
# Which model to run
# ---------------------------------------------------------------------------

# Folder name under models\ — resolved to the .gguf inside it.
# Download it first with: pnpm my-local-ai:model qwen-coder-7b
MODEL_PRESET=qwen-coder-7b

# Full path to a .gguf. Overrides MODEL_PRESET when set. Read by llama.cpp.
#LLAMA_ARG_MODEL=D:\my-work-3\models\qwen-coder-7b\Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf

# ---------------------------------------------------------------------------
# llama-server — these are llama.cpp's own LLAMA_ARG_* variables
# Full list: pnpm my-local-ai:server -- --help
# ---------------------------------------------------------------------------

#LLAMA_ARG_HOST=127.0.0.1
#LLAMA_ARG_PORT=8080

# Context window in tokens. Bigger = more RAM/VRAM.
#LLAMA_ARG_CTX_SIZE=8192

# Layers to offload to the GPU. 99 = all of them, 0 = CPU only.
#LLAMA_ARG_N_GPU_LAYERS=99

#LLAMA_ARG_FLASH_ATTN=1

# ---------------------------------------------------------------------------
# Downloads (pnpm my-local-ai:model)
# ---------------------------------------------------------------------------

# Default quantization when --quant is not passed.
#HF_QUANT=Q4_K_M

# Needed only for gated repos.
#HF_TOKEN=

# Set only if the hf CLI cannot be found automatically.
#HF_CLI=
